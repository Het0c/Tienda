{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Tienda Girasol",
    "version": "0.1.0",
    "identifier": "cl.girasol.tienda",
    "build": {
        "beforeDevCommand": "cd frontend && npm run dev",
        "beforeBuildCommand": "cd frontend && npm run build",
        "devUrl": "localhost:5173",
        "frontendDist": "../frontend/dist"
    },
    "app": {
        "windows": [
            {
                "title": "Tienda Girasol",
                "width": 1280,
                "height": 800,
                "minWidth": 1024,
                "minHeight": 700
            }
        ]
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "externalBin": [
            "binaries/tienda-api"
        ]
    }
}